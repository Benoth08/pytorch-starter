{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "train (default.yaml)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train.py",
            "args": ["--config", "configs/default.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "evaluate (default.yaml)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/evaluate.py",
            "args": ["--config", "configs/default.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "train_yolo (yolo_quick.yaml)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_yolo.py",
            "args": ["--config", "configs/yolo_quick.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "train_anomaly (anomaly_ae.yaml)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_anomaly.py",
            "args": ["--config", "configs/anomaly_ae.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "train_segmentation (segmentation.yaml)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_segmentation.py",
            "args": ["--config", "configs/segmentation.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "fichier courant",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
